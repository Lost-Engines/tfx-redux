# Archive only the explicitly installed Runtime tree.
foreach(required IN ITEMS PACKAGE_ROOT OUTPUT_DIR PLATFORM)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "Missing package argument: ${required}")
  endif()
endforeach()
if(NOT PLATFORM MATCHES "^(linux|windows|macos)-x86_64$")
  message(FATAL_ERROR "Unsupported package platform: ${PLATFORM}")
endif()
set(package "tfx-redux")
if(NOT EXISTS "${PACKAGE_ROOT}/${package}/LICENSE")
  message(FATAL_ERROR "Missing Runtime install tree or licence")
endif()
file(MAKE_DIRECTORY "${OUTPUT_DIR}")
set(name "${package}-${PLATFORM}")
if(PLATFORM MATCHES "^windows-")
  set(archive "${OUTPUT_DIR}/${name}.zip")
  set(arguments cf "${archive}" --format=zip "${package}")
else()
  set(archive "${OUTPUT_DIR}/${name}.tar.gz")
  set(arguments czf "${archive}" "${package}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -E tar ${arguments}
  WORKING_DIRECTORY "${PACKAGE_ROOT}" COMMAND_ERROR_IS_FATAL ANY)
